{
  "requiredEnv": ["CIRCLECI_TOKEN", "AWS_ACCOUNT_ID", "AWS_ROLE_ARN", "CIRCLE_OIDC_TOKEN_V2"],
  "mcpServers": {
    "circleci-mcp-server": {
      "command": "npx",
      "args": ["-y", "@circleci/mcp-server-circleci@latest"],
      "env": {
        "CIRCLECI_TOKEN": "${CIRCLECI_TOKEN}",
        "CIRCLECI_BASE_URL": "https://circleci.com"
      }
    },
    "awslabs.aws-api-mcp-server": {
      "command": "bash",
      "args": [
        "-c",
        "pip install uv --quiet 2>/dev/null; echo \"${CIRCLE_OIDC_TOKEN_V2}\" > /tmp/circleci_oidc_token && AWS_WEB_IDENTITY_TOKEN_FILE=/tmp/circleci_oidc_token uvx awslabs.aws-api-mcp-server@latest"
      ],
      "env": {
        "AWS_REGION": "ap-northeast-1",
        "READ_OPERATIONS_ONLY": "true",
        "AWS_ACCOUNT_ID": "${AWS_ACCOUNT_ID}",
        "AWS_ROLE_ARN": "${AWS_ROLE_ARN}",
        "CIRCLE_OIDC_TOKEN_V2": "${CIRCLE_OIDC_TOKEN_V2}"
      }
    }
  }
}
